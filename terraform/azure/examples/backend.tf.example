# Copy to the project's backend.tf after the shared state account exists.
# If you changed the keep group or account names, change those lines too.
# Then change the blob key. One blob per project.

terraform {
  backend "azurerm" {
    resource_group_name  = "rg-tfstate-zeon01"
    storage_account_name = "sttfstatezeon01"
    container_name       = "tfstate"
    key                  = "REPLACE-PROJECT.tfstate"
    use_azuread_auth     = true
  }
}
