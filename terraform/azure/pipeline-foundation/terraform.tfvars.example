# Copy this to terraform.tfvars (it's gitignored). The defaults are the names
# from my own proof of concept. If you're not me (zeon), set owner and the two
# state names.
# Leave projects empty until a project's resource group exists.
# Get GitHub ids from:
#   ../modules/github-oidc/scripts/oidc-ids.sh owner/name

# owner                     = "yourname"
# state_resource_group_name = "rg-tfstate-yourname01"
# state_storage_account_name = "sttfstateyourname01"
#
# Do not invent a resource group name. Use the name that project already locked.
# Azure 8 locked rg-cost-poc-zeon01. Its state blob key is cost-dashboard.tfstate.
# Azure 9 locked rg-backup-poc-zeon01.
#
# projects = {
#   cost-dashboard = {
#     github_repository            = "zsociety47/azure-cost-dashboard"
#     github_owner_id              = "122703085"
#     github_repository_id         = "replace-me"
#     pipeline_resource_group_name = "rg-cost-poc-zeon01"
#   }
# }

projects = {}
